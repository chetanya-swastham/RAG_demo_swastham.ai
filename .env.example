# Swastham Forward-Translation RAG - Environment Configuration
# Copy this file to .env and fill in your API key.

# Groq (default provider)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# Embedding model (downloaded locally via sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Retrieval settings
TOP_K=4

# Voice (optional). Speech-to-text uses Groq Whisper with GROQ_API_KEY; speech output uses edge-tts
STT_MODEL=whisper-large-v3
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
